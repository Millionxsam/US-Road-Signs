<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SignForge: offline build tool for the US Road Signs mod.
    Renders sign face textures, material textures and UI icons from the data catalog, and exports
    OBJ previews. Uses WPF (part of .NET Framework 4.8) for high quality vector rendering.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>SignForge</RootNamespace>
    <AssemblyName>SignForge</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Newtonsoft.Json is taken from the game installation (the same assembly the mod uses at runtime). -->
  <PropertyGroup>
    <GameManagedDir Condition="'$(GameManagedDir)' == '' AND Exists('C:\XboxGames\Cities- Skylines II - PC Edition\Content\Cities2_Data\Managed\Newtonsoft.Json.dll')">C:\XboxGames\Cities- Skylines II - PC Edition\Content\Cities2_Data\Managed</GameManagedDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed\Newtonsoft.Json.dll')">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</GameManagedDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</GameManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
